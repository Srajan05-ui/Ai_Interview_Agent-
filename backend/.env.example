# Backend Environment Variables (for Render)
# At minimum, provide one LLM key and the Firebase Admin JSON

# --- REQUIRED ---
# Firebase Admin SDK credentials (full JSON as a single-line string)
FIREBASE_ADMIN_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# At least ONE LLM key is required (tries Gemini → Groq → OpenRouter → fallback)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# --- OPTIONAL ---
# Defaults to SQLite if not set (fine for development and MVP)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname